# Secrets
.env
.env.local
*.env.local
!.env.example

# Python
backend/venv/
backend/.venv/
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Vite
node_modules/
frontend/dist/
frontend/dev-dist/
*.tsbuildinfo
.vite/

# Local HTTPS certificates (generated per machine)
certs/
frontend/.certs/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test output
test-results/
playwright-report/
e2e/output/

# Large model weights are fetched and SHA-256-verified by tools/fetch_models.py
# (the Docker build runs it); only the small fast model is committed.
frontend/public/models/*.onnx
frontend/public/models/*.part
# Local benchmark images (not redistributable); see frontend/vision-lab.html
frontend/public/test-media/

# Datasets: only manifests, split definitions and READMEs are versioned.
# Everything else under data/ is downloaded or generated by tools/datasets.py.
data/*
!data/README.md
!data/manifests/
!data/splits/
data/splits/*.cache
# Backend / evaluation model weights (fetched by tools/fetch_models.py)
models/weights/

# Bundled evaluation tools (npm run build:tools)
frontend/.tools/

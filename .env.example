# Reality Debugger - backend configuration
# Copy this file to `.env` (repository root) or `backend/.env` and fill in a key.
# Never commit your real .env. The frontend never sees these values.

# ---------------------------------------------------------------------------
# AI provider
#   auto      -> anthropic if ANTHROPIC_API_KEY is set, else openai if
#                OPENAI_API_KEY / OPENAI_BASE_URL is set, else DEMO MODE
#   anthropic -> Claude (recommended)
#   openai    -> any OpenAI-compatible /chat/completions endpoint with vision
#                (OpenAI, Ollama, LM Studio, vLLM, OpenRouter, ...)
#   demo      -> force DEMO MODE (simulated, clearly labelled, no key needed)
# ---------------------------------------------------------------------------
AI_PROVIDER=auto

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (beta). Set to false if your endpoint rejects it.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- OpenAI-compatible (optional alternative) ---
# OpenAI:  OPENAI_BASE_URL=https://api.openai.com/v1   OPENAI_MODEL=<a vision model>
# Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2-vision   (no key needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Tuning (defaults are sensible; uncomment to change)
# ---------------------------------------------------------------------------
# Effort for live frames (fast) vs deep scans / images / video (thorough).
# Leave empty to omit the parameter for models that do not support it.
# AI_EFFORT_LIVE=low
# AI_EFFORT_DEEP=medium
# AI_TIMEOUT_SECONDS=120
# AI_MAX_CONCURRENCY=4
# Cost guard: max vision-model calls per live scan per minute.
# SCAN_AI_CALLS_PER_MINUTE=12

# Upload limits (bytes)
# MAX_IMAGE_BYTES=15728640
# MAX_FRAME_BYTES=5242880
# MAX_VIDEO_BYTES=314572800
# MAX_VIDEO_KEYFRAMES=12

# CORS: extra allowed origins (comma separated). Localhost and private LAN
# addresses (192.168.x.x, 10.x.x.x, 172.16-31.x.x, *.local) are allowed by
# default via CORS_ALLOW_LAN=true.
# CORS_ORIGINS=http://localhost:5173,https://localhost:5173
# CORS_ALLOW_LAN=true

# LOG_LEVEL=INFO

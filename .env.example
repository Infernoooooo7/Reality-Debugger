# Reality Debugger - backend configuration
# Copy this file to `.env` (repository root) or `backend/.env`.
# Never commit your real .env. The frontend never sees these values.
#
# NO KEY IS REQUIRED. Object detection (EfficientDet-Lite0 + YOLOX-S in the
# browser), tracking, scene relations and the diagnostic engine all run
# locally. An API key only adds the optional AI reasoning layer (explanations,
# issues outside the detectors' vocabulary, scene naming).

# ---------------------------------------------------------------------------
# Optional AI reasoning layer
#   auto   -> gemini when GEMINI_API_KEY is set, otherwise local-only.
#             Claude / OpenAI are never selected implicitly (no accidental
#             paid usage): name them in AI_PROVIDER.
#   none   -> local-only, even if keys are present
#   gemini -> Google Gemini (GEMINI_API_KEY)
#   claude -> Anthropic Claude (ANTHROPIC_API_KEY)
#   openai -> any OpenAI-compatible /chat/completions endpoint with vision
# ---------------------------------------------------------------------------
AI_PROVIDER=auto

# A second provider is called after the first one fails ONLY if named here.
# Keep "none" unless you accept paying for the fallback provider.
AI_FALLBACK_PROVIDER=none

# --- Google Gemini ---
GEMINI_API_KEY=
# Default: gemini-flash-latest (config/ai.json). Any model with image input and JSON output.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=

# --- Anthropic Claude (only with AI_PROVIDER=claude or AI_FALLBACK_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (beta). Set to false if your endpoint rejects it.
# ANTHROPIC_REFUSAL_FALLBACK=true

# --- OpenAI-compatible (only with AI_PROVIDER=openai) ---
# OpenAI:  OPENAI_BASE_URL=https://api.openai.com/v1   OPENAI_MODEL=<a vision model>
# Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2-vision   (no key needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Tuning (defaults are sensible; uncomment to change)
# ---------------------------------------------------------------------------
# When the AI is called (triggers, cooldown, per-minute budget, de-duplication
# cache, failure back-off, image sizes) is set in config/ai.json.
# Override the per-scan budget (config default: 6 calls per minute):
# SCAN_AI_CALLS_PER_MINUTE=6
# Effort for live frames vs. deep scans / images / video (Claude). Empty = omit.
# AI_EFFORT_LIVE=low
# AI_EFFORT_DEEP=medium
# AI_TIMEOUT_SECONDS=120
# AI_MAX_CONCURRENCY=4

# Shared parameter files (vision, detection, tracking, temporal, diagnostics,
# ai, ontology). Default: <repo>/config
# CONFIG_DIR=

# COOP/COEP headers: cross-origin isolation enables multi-threaded WebAssembly
# for the in-browser deep detector. Disable only if you embed third-party
# resources that lack CORP headers.
# CROSS_ORIGIN_ISOLATION=true

# Upload limits (bytes)
# MAX_IMAGE_BYTES=15728640
# MAX_FRAME_BYTES=5242880
# MAX_VIDEO_BYTES=314572800
# MAX_VIDEO_KEYFRAMES=12
# MAX_SCENE_CHARS=96000

# Live-scan sessions are kept in memory only (findings text, no images).
# SCAN_TTL_SECONDS=7200
# MAX_SCANS=200

# CORS: extra allowed origins (comma separated). Localhost and private LAN
# addresses (192.168.x.x, 10.x.x.x, 172.16-31.x.x, *.local) are allowed by
# default via CORS_ALLOW_LAN=true.
# CORS_ORIGINS=http://localhost:5173,https://localhost:5173
# CORS_ALLOW_LAN=true

# Single-service mode: serve the built frontend from the backend (Docker sets this).
# FRONTEND_DIST=../frontend/dist

# LOG_LEVEL=INFO

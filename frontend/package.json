{
  "name": "reality-debugger-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reality Debugger frontend: camera, on-device vision engine and diagnostic UI.",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}

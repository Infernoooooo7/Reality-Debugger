 "tracker": {
  "method": "One real photo per sequence, drawn 1.1x zoomed into a 480 px wide canvas and shifted per frame; each frame goes through the real fast detector and a fresh ByteTrack Tracker. 40 frames at a nominal 100 ms (10 fps). Speeds are Kalman-estimated centre speeds in normalised frame units per second (frame widths for horizontal motion) of confirmed tracks with >= 4 hits, sampled from frame 8 on.",
  "scenarios": {
   "identical": "the same frame 40 times",
   "jitter_0.5pct": "static camera, uniform random offset in [-0.5%, +0.5%] of the frame per frame (hand tremor)",
   "jitter_1pct": "static camera, uniform random offset in [-1%, +1%] per frame",
   "pan_0.05fw_s": "constant horizontal pan at 0.05 frame widths per second",
   "pan_0.10fw_s": "constant horizontal pan at 0.10 frame widths per second",
   "pan_0.20fw_s": "constant horizontal pan at 0.20 frame widths per second"
  },
